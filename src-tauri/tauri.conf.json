{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mlis",
  "version": "0.1.0",
  "identifier": "github.com.casien.mlis",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "transparent": true,
        "decorations": false,
        "hiddenTitle": true,
        "alwaysOnTop": true,
        "fullscreen": false,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
